      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"habittracker\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"habittracker\"}[5m])), 0.0001)",
          "legendFormat": "5xx ratio",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Share of requests answered with a 5xx. `or vector(0)` keeps the panel at zero instead of blank when there are no errors at all; clamp_min avoids divide-by-zero while the app is idle."
